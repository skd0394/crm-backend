{
  "name": "crm",
  "private": true,
  "description": "Counselor CRM: Express + Postgres API and React web client",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @crm/api & npm run dev -w @crm/web",
    "dev:api": "npm run dev -w @crm/api",
    "dev:web": "npm run dev -w @crm/web",
    "build": "npm run build -w @crm/web",
    "test": "npm test -w @crm/api",
    "lint": "npm run lint -w @crm/web",
    "db:migrate": "npm run db:migrate -w @crm/api"
  },
  "engines": {
    "node": ">=20"
  }
}
